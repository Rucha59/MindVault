<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and older (API 26-30).
    The encrypted session and the "last open vault" marker must never be restored to another device.
    Per-account vaults live in no_backup/, which Android never backs up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="mindvault_auth.xml" />
    <exclude domain="sharedpref" path="mindvault_active_owner.xml" />
</full-backup-content>